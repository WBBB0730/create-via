{
  "name": "create-via",
  "type": "module",
  "version": "0.0.1",
  "description": "从模板仓库创建新项目：交互式填写项目名，支持 Git LFS，完成后做一个初始提交",
  "author": "WBBB",
  "license": "MIT",
  "homepage": "https://github.com/WBBB0730/create-via#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WBBB0730/create-via.git"
  },
  "keywords": [
    "create",
    "template",
    "scaffold",
    "git-lfs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-via": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "cac": "^7.1.0",
    "giget": "^3.3.1",
    "tinyexec": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
